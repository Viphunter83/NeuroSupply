# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=neurosupply
POSTGRES_HOST=db
POSTGRES_PORT=5432
PG_DSN=postgresql+asyncpg://user:password@localhost:5432/neurosupply

# Redis
REDIS_URL=redis://redis:6379/0

# iikoCloud
IIKO_API_LOGIN=your_iiko_login
IIKO_API_KEY=your_iiko_api_key
IIKO_ORG_ID=your_org_id

# Telegram
BOT_TOKEN=your_telegram_bot_token
WEBAPP_URL=https://your-tma-url.com

# Procob
PROCOB_API_KEY=your_procob_key

# Security
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
JWT_SECRET_KEY=your_custom_jwt_secret
DEMO_RESTAURANT_ID=00000000-0000-0000-0000-000000000000

# Feature Flags
USE_MOCK_DATA=False
